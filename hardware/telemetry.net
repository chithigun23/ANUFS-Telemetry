		(libpart
			(lib "telemetry")
			(part "LC29HEAMD")
			(description "Quectel LC29H(EA) dual-band GNSS module. Per Hardware Design v1.4 the EA does not support D_SEL, UART2, I2C or SPI: pins 2, 4, 5, 6, 15 and 16 are reserved and must be left N/C. In the Moving Base (dual-antenna heading) application, pins 18 and 19 are TXD2 and RXD2 (joined to the rover UART1 pins 20 and 21) and pin 17 is RESET_CTL, an output that drives the rover RESET_N (leave it N/C on the rover). Pin 17 is reserved otherwise.")
