(version 1)
# J7 locating holes: 0.65 mm per SHOU HAN C2765186 recommended PCB drawing.
# Use APPPD's JLCPCB 0.20 mm NPTH-to-copper clearance only within J7.
# Other footprints and external tracks retain the board's existing constraints.
(rule "J7 USB-C locating holes to connector pads"
 (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && !A.isPlated() && A.memberOfFootprint('J7') && B.Type == 'Pad' && B.memberOfFootprint('J7')")
 (constraint hole_clearance (min 0.2mm))
)
